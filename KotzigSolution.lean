module

public import Mathlib
public import Kotzig.Main

/-!
# Proofs of the statements in `KotzigChallenge.lean`

The definitions below are verbatim copies of those in `KotzigChallenge.lean`. Planarity
coincides with that of the `LeanPool.K5MinorFreeChoosability` library of the registered entry
*Kuratowski's theorem* (`isPlanar_iff_lib`, field by field), and `3`-connectivity with
`Kotzig.ThreeConnected`; the theorems are those of `Kotzig/Main.lean`, proved by discharging on
the rotation system (`Kotzig/Discharging.lean`).
-/

@[expose] public section

noncomputable section

open Equiv Equiv.Perm

namespace KotzigTheorem

/-! ### Combinatorial planarity -/

section Hypermap

variable {α : Type*}

/-- The number of equivalence classes of a setoid. -/
noncomputable def numClasses (s : Setoid α) : ℕ := Nat.card (Quotient s)

/-- The number of cycles of a permutation (fixed points count as cycles of length one). -/
noncomputable def cycleCount (π : Perm α) : ℕ := numClasses (SameCycle.setoid π)

/-- The relation "in the same orbit of the group generated by `σ` and `τ`". -/
def compSetoid (σ τ : Perm α) : Setoid α where
  r := Relation.EqvGen (fun a b => b = σ a ∨ b = τ a)
  iseqv := Relation.EqvGen.is_equivalence _

/-- The number of orbits of the group generated by `σ` and `τ`. -/
noncomputable def numComponents (σ τ : Perm α) : ℕ := numClasses (compSetoid σ τ)

/-- The Euler defect `|α| + 2 K - c(σ) - c(τ) - c(σ τ)` of the hypermap `(σ, τ)`; it equals
twice the genus. -/
noncomputable def eulerDefect (σ τ : Perm α) : ℤ :=
  (Nat.card α : ℤ) + 2 * (numComponents σ τ : ℤ) - cycleCount σ - cycleCount τ -
    cycleCount (σ * τ)

end Hypermap

section Planar

variable {V : Type*} (G : SimpleGraph V)

/-- The dart reversal `d ↦ d.symm` of `G`, as a permutation of the darts. -/
def dartSymm : Perm G.Dart := Function.Involutive.toPerm _ SimpleGraph.Dart.symm_involutive

/-- A rotation system: a permutation of the darts preserving tails and cyclic on the darts at
each vertex. -/
structure IsRotationSystem (σ : Perm G.Dart) : Prop where
  fst_apply : ∀ d, (σ d).fst = d.fst
  sameCycle : ∀ d e : G.Dart, d.fst = e.fst → σ.SameCycle d e

/-- A plane map of `G`: a rotation system of genus zero (Euler defect `0`). -/
structure PlaneMap where
  /-- The rotation: the next dart around the tail. -/
  rot : Perm G.Dart
  isRotationSystem : IsRotationSystem G rot
  eulerDefect_eq_zero : eulerDefect rot (dartSymm G) = 0

/-- `G` is planar: it has a plane map. -/
def IsPlanar : Prop := Nonempty (PlaneMap G)

end Planar

/-- The planarity notion of this file is that of the `K5MinorFreeChoosability` library. -/
theorem isPlanar_iff_lib {V : Type*} (G : SimpleGraph V) :
    IsPlanar G ↔ LeanPool.K5MinorFreeChoosability.IsPlanar G := by
  constructor
  · rintro ⟨M⟩
    exact ⟨⟨M.rot, ⟨M.isRotationSystem.1, M.isRotationSystem.2⟩, M.eulerDefect_eq_zero⟩⟩
  · rintro ⟨M⟩
    exact ⟨⟨M.rot, ⟨M.isRotationSystem.1, M.isRotationSystem.2⟩, M.eulerDefect_eq_zero⟩⟩

/-! ### `3`-connectivity -/

/-- `G` is `3`-connected: it has at least four vertices and stays connected after the deletion
of any set of at most two vertices. -/
def ThreeConnected {V : Type*} [Fintype V] (G : SimpleGraph V) : Prop :=
  4 ≤ Fintype.card V ∧ ∀ S : Finset V, S.card ≤ 2 → (G.induce {v | v ∉ S}).Connected

theorem threeConnected_iff {V : Type*} [Fintype V] (G : SimpleGraph V) :
    ThreeConnected G ↔ Kotzig.ThreeConnected G := Iff.rfl

/-! ### Light edges -/

variable {V : Type*} [Fintype V] {G : SimpleGraph V} [DecidableRel G.Adj]

/-- **Kotzig's theorem** in the form conjectured by Erdős and proved by Borodin: a finite simple
planar graph of minimum degree at least three has an edge of weight at most `13`. -/
theorem kotzig_borodin [Nonempty V] (hG : IsPlanar G) (hδ : ∀ v, 3 ≤ G.degree v) :
    ∃ u v, G.Adj u v ∧ G.degree u + G.degree v ≤ 13 :=
  Kotzig.kotzig_borodin ((isPlanar_iff_lib G).1 hG) hδ

/-- A finite simple planar graph of minimum degree at least four has an edge of weight at most
`11`. -/
theorem light_edge_minDegree_four [Nonempty V] (hG : IsPlanar G) (hδ : ∀ v, 4 ≤ G.degree v) :
    ∃ u v, G.Adj u v ∧ G.degree u + G.degree v ≤ 11 :=
  Kotzig.light_edge_minDegree_four ((isPlanar_iff_lib G).1 hG) hδ

/-- **Kotzig's theorem (1955).** A `3`-connected planar graph has an edge of weight at most
`13`, and of weight at most `11` if it has no vertex of degree three. -/
theorem kotzig (hG : IsPlanar G) (h3 : ThreeConnected G) :
    (∃ u v, G.Adj u v ∧ G.degree u + G.degree v ≤ 13) ∧
      ((∀ v, G.degree v ≠ 3) → ∃ u v, G.Adj u v ∧ G.degree u + G.degree v ≤ 11) :=
  Kotzig.kotzig ((isPlanar_iff_lib G).1 hG) h3

/-- **Wernicke's theorem (1904).** A finite simple planar graph of minimum degree at least five
has a vertex of degree five adjacent to a vertex of degree at most six. -/
theorem wernicke [Nonempty V] (hG : IsPlanar G) (hδ : ∀ v, 5 ≤ G.degree v) :
    ∃ u v, G.Adj u v ∧ G.degree u = 5 ∧ G.degree v ≤ 6 :=
  Kotzig.wernicke ((isPlanar_iff_lib G).1 hG) hδ

end KotzigTheorem
